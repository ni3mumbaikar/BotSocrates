# ==========================================
# BotSocrates Environment Variables Example
# ==========================================

# Command Prefix (e.g., /, !, etc.)
PREFIX=/

# Port for Express API server (defaults to 3000)
PORT=3000


# FFMpeg executable path
# Inside the Docker container, this is automatically pre-configured to /usr/bin/ffmpeg.
# On local host systems, update this to your local FFmpeg binary path.
FFMPEG_PATH=/usr/bin/ffmpeg

# Comma-separated list of WhatsApp group IDs (JIDs) to send messages to via the Express API.
# (Used by external affiliate links and announcement scripts)
# Example: 120363430135287154@g.us,120363430135287155@g.us
GROUP_IDS=120363430135287154@g.us

# Comma-separated list of WhatsApp group IDs (JIDs) for Daily Chat Summarization.
# Each group is summarized isolatedly and sent strictly to that group at midnight.
# Example: 120363430135287154@g.us,120363430135287155@g.us
SUMMARY_GROUP_IDS=120363430135287154@g.us

# AI Agent Configuration for Chat Summarization (OpenClaw / AnyAPI.ai / OpenAI-compatible)
#
# Option A: OpenClaw Gateway (/v1/chat/completions enabled)
# OPENCLAW_API_URL=http://localhost:8080/v1/chat/completions
# OPENCLAW_API_KEY=your_openclaw_token
# OPENCLAW_MODEL=default
#
# Option B: AnyAPI.ai (Free Tier - 100K tokens/day)
# OPENCLAW_API_URL=https://api.anyapi.ai/v1/chat/completions
# OPENCLAW_API_KEY=your_anyapi_key_here
# OPENCLAW_MODEL=gpt-4o-mini
#
OPENCLAW_API_URL=https://api.anyapi.ai/v1/chat/completions
OPENCLAW_API_KEY=your_api_key_here
OPENCLAW_MODEL=gpt-4o-mini

# Optional: Override the default multilingual system prompt.
# Leave blank or commented out to use the built-in Hinglish & Marathi-optimized prompt.
# SUMMARY_SYSTEM_PROMPT=You are an AI group chat summarizer...


